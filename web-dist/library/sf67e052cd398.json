"","kind":"instrumental"},{"time":76.125,"end":80.065,"text":"오직 우리가 구속받게 하시려고"},{"time":80.065,"end":83.945,"text":"더러움에서 멀어지고 고통에서 벗어나도록"},{"time":83.945,"end":88.325,"text":"자기 생명으로 너와 나의 복이 되셨네"},{"time":88.325,"end":92.005,"text":"이 선물은 부활하신 예수님"},{"time":92.005,"end":92.685,"text":"","kind":"instrumental"},{"time":92.685,"end":96.505,"text":"할렐루야, 그리스도 예수"},{"time":96.505,"end":100.525,"text":"가장 아름다운 선물"},{"time":100.525,"end":104.355,"text":"할렐루야, 한목소리로 기뻐 외치세"},{"time":104.355,"end":107.985,"text":"가장 아름다운 선물을 주신 하나님께 감사드리네"},{"time":107.985,"end":124.475,"text":"","kind":"instrumental"},{"time":124.475,"end":128.475,"text":"이 세상에서 가장 아름다운 선물"},{"time":128.475,"end":131.845,"text":"그분을 받은 사람은 참으로 복되네"},{"time":131.845,"end":136.575,"text":"사랑하는 아빠, 하늘 아버지께 감사드리네"},{"time":136.575,"end":139.805,"text":"수많은 사람 가운데 너와 나를 택하셨네"},{"time":139.805,"end":140.445,"text":"","kind":"instrumental"},{"time":140.445,"end":143.965,"text":"이 세상에서 가장 아름다운 선물"},{"time":143.965,"end":147.845,"text":"그 선물은 온전히 거룩하신 그리스도"},{"time":147.845,"end":151.965,"text":"인자하신 아빠, 하늘 아버지께 감사드리네"},{"time":151.965,"end":156.075,"text":"보배로우신 예수님을 우리에게 주셨네"},{"time":156.075,"end":156.525,"text":"","kind":"instrumental"},{"time":156.525,"end":160.325,"text":"우리를 위해 십자가를 지셨네"},{"time":160.325,"end":164.055,"text":"우리를 위해 자신을 낮추고 모욕을 당하셨네"},{"time":164.055,"end":167.635,"text":"우리를 위해 피를 남김없이 흘리셨네"},{"time":167.635,"end":172.065,"text":"누가 이토록 자신을 내어 줄 수 있으랴"},{"time":172.065,"end":172.465,"text":"","kind":"instrumental"},{"time":172.465,"end":176.125,"text":"오직 우리가 구속받게 하시려고"},{"time":176.125,"end":179.785,"text":"더러움에서 멀어지고 고통에서 벗어나도록"},{"time":179.785,"end":183.865,"text":"자기 생명으로 너와 나의 복이 되셨네"},{"time":183.865,"end":187.895,"text":"이 선물은 부활하신 예수님"},{"time":187.895,"end":188.265,"text":"","kind":"instrumental"},{"time":188.265,"end":192.315,"text":"할렐루야, 그리스도 예수"},{"time":192.315,"end":196.355,"text":"가장 아름다운 선물"},{"time":196.355,"end":200.575,"text":"할렐루야, 한목소리로 기뻐 외치세"},{"time":200.575,"end